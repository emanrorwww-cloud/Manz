rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'emanrorwww@gmail.com' && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(adminId) && incoming().email is string && incoming().email.size() <= 100 && incoming().role in ['admin', 'teacher'];
      allow update, delete: if isBootstrappedAdmin();
    }

    // Subjects Collection
    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'name', 'totalQuizMinutes', 'passingGrade']) &&
             data.keys().hasOnly(['id', 'name', 'iconName', 'color', 'description', 'teacherName', 'targetQuestionCount', 'timerMode', 'timerSecondsPerQuestion', 'totalQuizMinutes', 'passingGrade', 'teacherNotes', 'isPublic', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.totalQuizMinutes is number && data.totalQuizMinutes > 0 && data.totalQuizMinutes <= 300 &&
             data.passingGrade is number && data.passingGrade >= 0 && data.passingGrade <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
             (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 100)) &&
             (!('teacherNotes' in data) || (data.teacherNotes is string && data.teacherNotes.size() <= 500));
    }

    match /subjects/{subjectId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(subjectId) && isValidSubject(incoming()) && incoming().id == subjectId;
      allow update: if isAdmin() && isValidId(subjectId) && isValidSubject(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Questions Collection
    function isValidQuestion(data) {
      return data.keys().hasAll(['id', 'subjectId', 'question', 'options', 'correctAnswer', 'explanation']) &&
             data.keys().hasOnly(['id', 'subjectId', 'question', 'options', 'correctAnswer', 'explanation', 'difficulty']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 64 &&
             data.question is string && data.question.size() > 0 && data.question.size() <= 2000 &&
             data.options is map &&
             data.options.keys().hasAll(['A', 'B', 'C', 'D']) &&
             data.options.keys().hasOnly(['A', 'B', 'C', 'D']) &&
             data.options.A is string && data.options.A.size() <= 500 &&
             data.options.B is string && data.options.B.size() <= 500 &&
             data.options.C is string && data.options.C.size() <= 500 &&
             data.options.D is string && data.options.D.size() <= 500 &&
             data.correctAnswer in ['A', 'B', 'C', 'D'] &&
             data.explanation is string && data.explanation.size() <= 1000;
    }

    match /questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(questionId) && isValidQuestion(incoming()) && incoming().id == questionId;
      allow update: if isAdmin() && isValidId(questionId) && isValidQuestion(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // Results Collection
    function isValidQuizResult(data) {
      return data.keys().hasAll(['id', 'userId', 'studentName', 'studentClass', 'subjectId', 'subjectName', 'totalQuestions', 'score', 'passed', 'passingGrade', 'timeSpentSeconds']) &&
             data.keys().hasOnly(['id', 'userId', 'studentName', 'studentClass', 'studentNis', 'subjectId', 'subjectName', 'teacherName', 'totalQuestions', 'correctAnswers', 'wrongAnswers', 'unanswered', 'score', 'passed', 'passingGrade', 'timeSpentSeconds', 'timestamp', 'createdAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 100 &&
             data.studentClass is string && data.studentClass.size() > 0 && data.studentClass.size() <= 50 &&
             data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 64 &&
             data.subjectName is string && data.subjectName.size() > 0 && data.subjectName.size() <= 100 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.score is number && data.score >= 0 && data.score <= 100 &&
             data.passed is bool &&
             data.passingGrade is number && data.passingGrade >= 0 && data.passingGrade <= 100 &&
             data.timeSpentSeconds is number && data.timeSpentSeconds >= 0;
    }

    match /results/{resultId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isVerified() &&
                       isValidId(resultId) &&
                       isValidQuizResult(incoming()) &&
                       incoming().id == resultId &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt == request.time;
      allow update: if false; // Results are immutable exam records
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
